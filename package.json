{
  "name": "mcp-runner",
  "version": "1.0.0",
  "description": "JavaScript runner for MCP workflows",
  "type": "module",
  "main": "index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "list-tools": "node examples/list-tools.js",
    "list-inbox": "node examples/list-inbox.js",
    "jira": "node examples/jira.js",
    "jira:read": "node examples/jira-read.js",
    "jira:transition": "node examples/jira-transition.js",
    "alarms": "node examples/setWorkDayAlarms.js",
    "alarms:dry": "node examples/setWorkDayAlarms.js -na"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.8.0"
  },
  "overrides": {
    "path-to-regexp": "7.2.0"
  },
  "keywords": [
    "mcp",
    "automation",
    "workflow"
  ],
  "author": "Robert Herrmann",
  "license": "MIT"
}
